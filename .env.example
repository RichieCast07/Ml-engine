# === CAPA 2: ML Engine ===

# Puerto en el que escucha el servicio
PORT=8001

# Clave que el NLP Service debe enviar en X-Internal-Service-Key
# Solo se exige si REQUIRE_INTERNAL_AUTH=true
INTERNAL_API_KEY=

# Activar autenticación interna entrante (false en desarrollo, true en producción)
REQUIRE_INTERNAL_AUTH=false

# Exponer /docs y /openapi.json (true en desarrollo, false en producción)
ENABLE_DOCS=true
